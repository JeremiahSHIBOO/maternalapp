# Backend environment variables (copy to .env and fill in)
# Supabase PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth (for verifying Flutter's access tokens)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# API configuration
BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# CORS (production: list your Flutter app domains)
ALLOWED_ORIGINS=

# Insight thresholds (optional overrides)
WELLNESS_SLEEP_SHORT_HOURS=6.0
WELLNESS_STRESS_HIGH=7
WELLNESS_ENERGY_LOW=3

# ML data gate (minimum check-in pairs before training)
WELLNESS_ML_MIN_RECORDS=60

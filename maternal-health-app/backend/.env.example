# Environment Configuration for Maternal Health Companion
# ==========================================================

# Application
ENVIRONMENT=development
BASE_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maternal_health

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Feature Flags
ENABLE_AI_INSIGHTS=false
ENABLE_PARTNER_SHARING=true
ENABLE_DOCTOR_PORTAL=true

# CORS (comma-separated list for development)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Admin
ADMIN_USERS=